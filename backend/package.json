{
  "name": "@vacation-manager/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vacation manager API: Express web server with Common Event Framework routes, events and handlers",
  "type": "commonjs",
  "scripts": {
    "codegen": "tsx scripts/generateHandlerRegistry.ts",
    "predev": "npm run codegen",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run codegen",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vacation-manager/shared": "1.0.0",
    "@casl/ability": "^7.1.3",
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.21",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}
